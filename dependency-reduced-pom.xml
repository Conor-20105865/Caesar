<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>Cipher_App</artifactId>
  <name>Caesar</name>
  <version>1.0-SNAPSHOT</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>create-runtime-image</id>
            <goals>
              <goal>jlink</goal>
            </goals>
            <configuration>
              <stripDebug>false</stripDebug>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.example.caesar.Launcher</mainClass>
          <launcher>caesarcipher</launcher>
          <jlinkImageName>caesarcipher</jlinkImageName>
          <jlinkZipName>caesarcipherapp</jlinkZipName>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.example.caesar.Launcher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.6.0</version>
        <configuration>
          <name>CaesarCipher</name>
          <appVersion>1.0.0</appVersion>
          <vendor>Conor-20105865</vendor>
          <destination>target/installer</destination>
          <module>com.example.caesar/com.example.caesar.Launcher</module>
          <runtimeImage>${project.build.directory}/caesarcipher</runtimeImage>
          <type>EXE</type>
          <winDirChooser>true</winDirChooser>
          <winMenuGroup>CaesarCipher</winMenuGroup>
          <icon>src/main/resources/icons/app.ico</icon>
          <winShortcut>true</winShortcut>
          <winPerUserInstall>true</winPerUserInstall>
          <winShortcutPrompt>true</winShortcutPrompt>
          <winMenu>true</winMenu>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>macos-dmg</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <version>${javafx.maven.plugin.version}</version>
            <executions>
              <execution>
                <id>macos-runtime-image</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>jlink</goal>
                </goals>
                <configuration>
                  <mainClass>com.example.caesar.Launcher</mainClass>
                  <launcher>caesarcipher</launcher>
                  <jlinkImageName>caesarcipher</jlinkImageName>
                  <jlinkZipName>caesarcipherapp</jlinkZipName>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.0</version>
            <executions>
              <execution>
                <id>create-dmg</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <skip>false</skip>
                  <name>CaesarCipher</name>
                  <appVersion>1.0.0</appVersion>
                  <vendor>Conor-20105865</vendor>
                  <destination>target/installer</destination>
                  <module>com.example.caesar/com.example.caesar.Launcher</module>
                  <runtimeImage>/Users/conorcunningham/Documents/GitHub/Caesar/target/caesarcipher</runtimeImage>
                  <type>DMG</type>
                  <winDirChooser>true</winDirChooser>
                  <winMenuGroup>CaesarCipher</winMenuGroup>
                  <icon>src/main/resources/icons/app.ico</icon>
                  <winShortcut>true</winShortcut>
                  <winPerUserInstall>true</winPerUserInstall>
                  <winShortcutPrompt>true</winShortcutPrompt>
                  <winMenu>true</winMenu>
                </configuration>
              </execution>
            </executions>
            <configuration>
              <name>CaesarCipher</name>
              <appVersion>1.0.0</appVersion>
              <vendor>Conor-20105865</vendor>
              <destination>target/installer</destination>
              <module>com.example.caesar/com.example.caesar.Launcher</module>
              <runtimeImage>${project.build.directory}/caesarcipher</runtimeImage>
              <type>DMG</type>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>opentest4j</artifactId>
          <groupId>org.opentest4j</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-platform-commons</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-platform-engine</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>17.0.6</javafx.version>
    <junit.version>5.10.2</junit.version>
  </properties>
</project>
